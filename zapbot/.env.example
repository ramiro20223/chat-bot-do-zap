# Postgres (Supabase, Neon, Railway, Render, ou o seu). Em bancos gerenciados, use DATABASE_SSL=true.
DATABASE_URL=postgres://usuario:senha@localhost:5432/zapbot
DATABASE_SSL=false

# Chave para assinar o login. Gere uma: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# IA: Google Gemini, tem plano GRATUITO. Gere a chave em https://aistudio.google.com/apikey
GEMINI_API_KEY=
# "auto" = o bot escolhe sozinho o Gemini Flash mais novo liberado para a sua chave (recomendado: o Google aposenta modelos com frequência).
# Para fixar um modelo, escreva o nome, ex.: GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODEL=auto

# Velocidade
# Tempo máximo (ms) da pausa "digitando…" no WhatsApp. Menor = responde mais rápido (use 0 para nenhuma pausa).
WA_TYPING_MAX_MS=2500
# Se o Gemini der erro por causa do modo de raciocínio rápido, use GEMINI_THINKING=default
# GEMINI_THINKING=default
