# Postgres (Supabase, Neon, Railway, Render, ou o seu). Em bancos gerenciados, use DATABASE_SSL=true.
DATABASE_URL=postgres://usuario:senha@localhost:5432/zapbot
DATABASE_SSL=false

# Chave para assinar o login. Gere uma: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# IA: Google Gemini, tem plano GRATUITO. Gere a chave em https://aistudio.google.com/apikey
GEMINI_API_KEY=
# "auto" = o bot escolhe sozinho o Gemini Flash mais novo liberado para a sua chave (recomendado: o Google aposenta modelos com frequência).
# Para fixar um modelo, escreva o nome, ex.: GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODEL=auto

# Velocidade
# Tempo máximo (ms) da pausa "digitando…" no WhatsApp. Menor = responde mais rápido (use 0 para nenhuma pausa).
WA_TYPING_MAX_MS=2500
# Se o Gemini der erro por causa do modo de raciocínio rápido, use GEMINI_THINKING=default
# GEMINI_THINKING=default

# ===== Segurança =====
# OBRIGATÓRIAS em produção (o servidor não sobe sem elas). Gere cada uma com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# AUTH_SECRET assina o login. DATA_ENCRYPTION_KEY criptografa a sessão do WhatsApp no banco. Devem ser DIFERENTES.
DATA_ENCRYPTION_KEY=

# Quem pode criar conta. Em produção o cadastro fica FECHADO, a menos que você defina um código de convite
# (mínimo 8 caracteres) ou ALLOW_REGISTRATION=true.
REGISTRATION_CODE=
# ALLOW_REGISTRATION=true

# Quantos proxies de confiança existem na frente do servidor (Railway/Render/Cloudflare = 1). Usado para achar o IP real do cliente.
TRUST_PROXY_HOPS=1

# Máximo de mensagens que um mesmo cliente pode mandar ao bot em 10 minutos (acima disso é ignorado).
WA_MAX_MSGS_PER_10MIN=30

# ===== Assinatura (R$ 99,99/mês) e administrador =====
# Pimenta das senhas dos clientes (segredo SÓ do servidor, diferente das outras). Sem ela, o servidor não sobe em produção.
# ATENÇÃO: se você trocar ou perder esta chave, ninguém mais consegue entrar (as senhas dependem dela). Guarde uma cópia segura.
PASSWORD_PEPPER=
# O cadastro precisa estar aberto para o cliente criar a conta pelo app:
ALLOW_REGISTRATION=true
# Seu WhatsApp (com DDD): é para onde o botão da assinatura manda o cliente, já com o ID dele na mensagem.
ADMIN_WHATSAPP=
# Conta do administrador (só você). Rode "npm run admin:setup" e cole as 3 linhas que ele mostrar:
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
ADMIN_TOTP_SECRET=
# Só para testar no seu computador sem assinatura (NUNCA em produção):
# SUBSCRIPTION_REQUIRED=false
